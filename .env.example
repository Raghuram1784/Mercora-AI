# Mercora AI - Root Environment Template
# Duplicate this file to .env for local development

NODE_ENV=development
PORT=5000

# Database Connection (Neon PostgreSQL / Local Postgres)
DATABASE_URL="postgresql://user:password@ep-sample-pooler.region.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-sample.region.aws.neon.tech/neondb?sslmode=require"

# Frontend CORS Origin & Base URL
FRONTEND_URL="http://localhost:5173"

# Groq LLM API Key & Model Configuration
LLM_PROVIDER="groq"
GROQ_API_KEY="your_groq_api_key_here"
GROQ_MODEL="openai/gpt-oss-20b"

# Razorpay Test Mode API Credentials
RAZORPAY_KEY_ID="rzp_test_your_key_id_here"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret_here"

# Frontend Client Public Variables (Vite prefix)
VITE_API_BASE_URL="http://localhost:5000/api"
VITE_RAZORPAY_KEY_ID="rzp_test_your_key_id_here"
VITE_DEMO_CUSTOMER_ID="c0a80101-0000-0000-0000-000000000001"
